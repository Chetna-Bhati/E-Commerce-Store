PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=threadline_db
DB_CONNECTION_LIMIT=10

# Auth
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d

# Razorpay (Test Mode)
RAZORPAY_KEY_ID=rzp_test_threadline
RAZORPAY_KEY_SECRET=rzp_test_secret_threadline

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
